# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shortcut"

# Domain shown in short links, without scheme (e.g. localhost:3000 in dev)
NEXT_PUBLIC_SHORT_DOMAIN="localhost:3000"

# Repository link for the "Source" button in the header
NEXT_PUBLIC_SOURCE_URL="https://github.com/Cage4D/url-shortener"
